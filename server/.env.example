# Anthropic — used for chat generation
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — used only for text embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT secret for admin API auth (generate a long random string)
JWT_SECRET=your-long-random-secret-here

# Admin credentials (used by the chatbot admin API)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Server
PORT=3001
NODE_ENV=production

# CORS — comma-separated allowed origins
CORS_ORIGINS=https://trenteducation.co.uk,http://localhost:5173
